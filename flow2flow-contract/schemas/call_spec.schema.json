{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CallSpec",
  "type": "object",
  "required": [
    "mode",
    "target"
  ],
  "properties": {
    "join": {
      "anyOf": [
        {
          "$ref": "#/definitions/JoinSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "$ref": "#/definitions/CallMode"
    },
    "on_error": {
      "anyOf": [
        {
          "$ref": "#/definitions/OnErrorSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "params_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "retry": {
      "anyOf": [
        {
          "$ref": "#/definitions/RetrySpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/definitions/Scope"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "string"
    },
    "timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "CallMode": {
      "type": "string",
      "enum": [
        "sync",
        "async",
        "fire_and_forget"
      ]
    },
    "JoinSpec": {
      "type": "object",
      "properties": {
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/definitions/JoinStrategy"
            },
            {
              "type": "null"
            }
          ]
        },
        "with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "JoinStrategy": {
      "type": "string",
      "enum": [
        "all",
        "any"
      ]
    },
    "OnErrorSpec": {
      "type": "object",
      "required": [
        "route"
      ],
      "properties": {
        "mapper": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "string"
        }
      }
    },
    "RetrySpec": {
      "type": "object",
      "required": [
        "attempts"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "delay_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_delay_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "Scope": {
      "type": "object",
      "required": [
        "tenant"
      ],
      "properties": {
        "team": {
          "type": [
            "string",
            "null"
          ]
        },
        "tenant": {
          "type": "string"
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
